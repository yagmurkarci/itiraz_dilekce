datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  number    String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  userRoles          UserRole[]
  userDepartments    UserDepartment[]
  userCourses        UserCourse[]
  coursesInstructed  CourseInstructor[]  @relation("CourseInstructor")
  requestsCreated    Request[]           @relation("RequestCreatedBy")
  requestsAssigned   Request[]           @relation("RequestAssignedTo")
  requestAttachments RequestAttachment[] @relation("AttachmentUploadedBy")

  @@map("users")
}

model Role {
  id       Int    @id @default(autoincrement())
  roleName String @unique @map("role_name")

  userRoles     UserRole[]
  endpointRoles EndpointRole[]

  @@map("roles")
}

model UserRole {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  roleId    Int      @map("role_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model Department {
  id             Int      @id @default(autoincrement())
  departmentName String   @map("department_name")
  createdAt      DateTime @default(now()) @map("created_at")

  courses         Course[]
  userDepartments UserDepartment[]
  requests        Request[]

  @@map("departments")
}

model UserDepartment {
  id           Int      @id @default(autoincrement())
  userId       Int      @map("user_id")
  departmentId Int      @map("department_id")
  createdAt    DateTime @default(now()) @map("created_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([userId, departmentId])
  @@map("user_departments")
}

model Course {
  id           Int      @id @default(autoincrement())
  courseCode   String   @unique @map("course_code")
  courseName   String   @map("course_name")
  departmentId Int      @map("department_id")
  createdAt    DateTime @default(now()) @map("created_at")

  department  Department         @relation(fields: [departmentId], references: [id])
  userCourses UserCourse[]
  instructors CourseInstructor[]
  requests    Request[]

  @@map("courses")
}

model UserCourse {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  courseId  Int      @map("course_id")
  semester  String?
  createdAt DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId, semester])
  @@map("user_courses")
}

model CourseInstructor {
  id           Int      @id @default(autoincrement())
  courseId     Int      @map("course_id")
  instructorId Int      @map("instructor_id")
  createdAt    DateTime @default(now()) @map("created_at")

  course     Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  instructor User   @relation("CourseInstructor", fields: [instructorId], references: [id], onDelete: Cascade)

  @@unique([courseId, instructorId])
  @@map("course_instructors")
}

model Request {
  id              Int      @id @default(autoincrement())
  title           String
  description     String
  requestType     String   @map("request_type")
  status          String   @default("PENDING")
  createdBy       Int      @map("created_by")
  courseId        Int      @map("course_id")
  departmentId    Int      @map("department_id")
  assignedTo      Int?     @map("assigned_to")
  answer          String?
  newGrade        Int?     @map("new_grade")
  rejectionReason String?  @map("rejection_reason")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  creator     User                @relation("RequestCreatedBy", fields: [createdBy], references: [id])
  assignee    User?               @relation("RequestAssignedTo", fields: [assignedTo], references: [id])
  course      Course              @relation(fields: [courseId], references: [id])
  department  Department          @relation(fields: [departmentId], references: [id])
  attachments RequestAttachment[]

  @@index([status])
  @@index([createdBy])
  @@map("requests")
}

model RequestAttachment {
  id         Int      @id @default(autoincrement())
  requestId  Int      @map("request_id")
  uploadedBy Int      @map("uploaded_by")
  filePath   String   @map("file_path")
  fileName   String   @map("file_name")
  mimeType   String   @map("mime_type")
  createdAt  DateTime @default(now()) @map("created_at")

  request  Request @relation(fields: [requestId], references: [id], onDelete: Cascade)
  uploader User    @relation("AttachmentUploadedBy", fields: [uploadedBy], references: [id])

  @@map("request_attachments")
}

model Endpoint {
  id           Int      @id @default(autoincrement())
  routerPath   String   @map("router_path")
  endpointPath String   @map("endpoint_path")
  method       String
  description  String?
  createdAt    DateTime @default(now()) @map("created_at")

  endpointRoles EndpointRole[]

  @@unique([endpointPath, method], name: "endpointPath_method")
  @@map("endpoints")
}

model EndpointRole {
  id         Int      @id @default(autoincrement())
  endpointId Int      @map("endpoint_id")
  roleId     Int      @map("role_id")
  createdAt  DateTime @default(now()) @map("created_at")

  endpoint Endpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  role     Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([endpointId, roleId])
  @@map("endpoint_roles")
}